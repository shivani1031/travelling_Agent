# Required API keys
GROQ_API_KEY=replace-with-your-groq-key
TAVILY_API_KEY=replace-with-your-tavily-key
AVIATIONSTACK_API_KEY=replace-with-your-aviationstack-key

# Flask signs a per-browser conversation identifier with this secret.
SECRET_KEY=replace-with-a-random-secret

# Local development with docker-compose:
DATABASE_URL=postgresql://travel:localdevpassword@localhost:5432/travel

# For Render, use your Neon connection string (including sslmode=require).

# Used by docker-compose for the local PostgreSQL service.
POSTGRES_PASSWORD=replace-with-a-strong-password
